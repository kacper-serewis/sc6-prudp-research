{
  "name": "bun-impl",
  "description": "TypeScript (Bun) port of the 5th-echelon Splinter Cell: Blacklist server",
  "module": "src/main.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "generate": "bun run scripts/generate-protocols.ts",
    "verify-protocols": "bun run scripts/verify-against-rust.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "@grpc/reflection": "^1.0.4",
    "chalk": "^5.4.0",
    "tweetnacl": "^1.0.3"
  }
}
